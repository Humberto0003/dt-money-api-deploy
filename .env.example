# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL local.
# Nunca coloque credenciais reais neste arquivo, pois ele pode ser versionado.

# Formato:
# postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=SCHEMA

# Exemplo local com placeholders:
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@localhost:5432/NOME_DO_BANCO?schema=public"

# Exemplo para Supabase/Vercel com placeholders:
# DATABASE_URL="postgresql://USUARIO:SENHA@HOST_SUPABASE:5432/postgres?schema=public&sslmode=require"

# Porta da API NestJS. Se nao informar, o projeto usa 3333.
PORT=3333
